# 机器人 Token，从 BotFather 获取
BOT_TOKEN=YOUR_NEW_BOT_TOKEN

# 管理员 Telegram User ID，多个用逗号分隔
ADMIN_USER_IDS=123456789,987654321

# 默认绑定，JSON 格式：{"用户ID": 群组ChatID}
DEFAULT_BINDINGS={"123456789": -1003145884431}

# SQLite 数据库文件路径
DB_FILE=resource_backup.db

# Album 等待时间（秒）
ALBUM_WAIT_SECONDS=1.5

# 健康检查 HTTP 端口。Render 会自动注入 PORT，本地默认 8080。
PORT=8080